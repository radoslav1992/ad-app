{
  "name": "ad-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply ad-app --local",
    "db:remote": "wrangler d1 migrations apply ad-app --remote",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "npm run check && npm run lint && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "hono": "^4.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.71.0"
  }
}
